# Assets locally rakhne hain, .gitignore se exclude hain.
# Clone karne waalo ko ASSETS_README.md padhna chahiye.

# All character sprites (paid asset pack)
public/assets/characters/

# Tilesets (if paid)
public/assets/tilesets/

# Audio assets (if paid/licensed)
public/assets/audio/

# Godot import files (if accidentally copied)
*.import

