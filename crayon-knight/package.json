{
  "name": "crayon-knight",
  "version": "0.1.0",
  "description": "Crayon Knight - A Rogue-Lite Top-Down Dungeon Crawler",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "deploy": "npm run build && gh-pages -d dist/crayon-knight",
    "deploy:netlify": "netlify deploy --prod --build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
